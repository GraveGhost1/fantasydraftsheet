{
  "manifest_version": 3,
  "name": "Ghost FF Assistant",
  "version": "1.18.0",
  "description": "Live Underdog and DraftKings Best Ball overlay using Ghost Fantasy Football rankings.",
  "action": {
    "default_title": "Ghost FF Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": [
    "https://*.underdogfantasy.com/*",
    "https://underdogfantasy.com/*",
    "https://*.underdogsports.com/*",
    "https://underdogsports.com/*",
    "https://api.underdogfantasy.com/*",
    "https://stats.underdogfantasy.com/*",
    "https://login.underdogsports.com/*",
    "https://login.underdogfantasy.com/*",
    "https://www.draftkings.com/*",
    "https://draftkings.com/*",
    "https://*.draftkings.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*"
      ],
      "js": ["adapters/underdog-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*",
        "http://127.0.0.1:8000/extension/test-draft-room.html",
        "http://localhost:8000/extension/test-draft-room.html",
        "http://127.0.0.1:8000/extension/test-explorer.html",
        "http://localhost:8000/extension/test-explorer.html"
      ],
      "js": [
        "lib/player-match.js",
        "data/nfl-schedule-2026.js",
        "data/nfl-games-2026.js",
        "lib/scoring-settings.js",
        "lib/playoff-schedule.js",
        "lib/slate.js",
        "lib/portfolio.js",
        "lib/csv-import.js",
        "lib/exposure-sync.js",
        "lib/duplicates.js",
        "lib/rank-board.js",
        "lib/capital-chart.js",
        "adapters/underdog.js",
        "overlay/highlight.js",
        "overlay/inject.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.draftkings.com/*",
        "https://draftkings.com/*",
        "https://*.draftkings.com/*"
      ],
      "js": ["adapters/draftkings-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.draftkings.com/*",
        "https://draftkings.com/*",
        "https://*.draftkings.com/*",
        "http://127.0.0.1:8000/extension/test-dk-draft-room.html*",
        "http://localhost:8000/extension/test-dk-draft-room.html*"
      ],
      "js": [
        "lib/player-match.js",
        "data/nfl-schedule-2026.js",
        "data/nfl-games-2026.js",
        "lib/scoring-settings.js",
        "lib/playoff-schedule.js",
        "lib/slate.js",
        "lib/portfolio.js",
        "lib/csv-import.js",
        "lib/exposure-sync.js",
        "lib/duplicates.js",
        "lib/rank-board.js",
        "lib/capital-chart.js",
        "adapters/draftkings.js",
        "overlay/highlight.js",
        "overlay/inject.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay/panel.css", "overlay/capital-chart.css"],
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*",
        "https://www.draftkings.com/*",
        "https://draftkings.com/*",
        "https://*.draftkings.com/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
      ]
    }
  ]
}
