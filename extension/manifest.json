{
  "manifest_version": 3,
  "name": "Draft Sheet Assistant",
  "version": "1.5.6",
  "description": "Live Underdog Best Ball overlay using your Fantasy Draft Sheet rankings.",
  "action": {
    "default_title": "Draft Sheet Assistant",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.underdogfantasy.com/*",
    "https://underdogfantasy.com/*",
    "https://*.underdogsports.com/*",
    "https://underdogsports.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*"
      ],
      "js": ["adapters/underdog-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*",
        "http://127.0.0.1:8000/extension/test-draft-room.html",
        "http://localhost:8000/extension/test-draft-room.html"
      ],
      "js": [
        "lib/player-match.js",
        "data/nfl-schedule-2026.js",
        "lib/scoring-settings.js",
        "lib/playoff-schedule.js",
        "lib/portfolio.js",
        "lib/duplicates.js",
        "lib/rank-board.js",
        "lib/capital-chart.js",
        "adapters/underdog.js",
        "overlay/highlight.js",
        "overlay/inject.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay/panel.css", "overlay/capital-chart.css"],
      "matches": [
        "https://*.underdogfantasy.com/*",
        "https://underdogfantasy.com/*",
        "https://*.underdogsports.com/*",
        "https://underdogsports.com/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*"
      ]
    }
  ]
}
